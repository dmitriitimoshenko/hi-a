GMAIL_USER=example@gmail.com
GMAIL_APP_PASSWORD="xxx"
OPENAI_API_KEY="xxx"
BOT_TOKEN="xxx"
SHEET_ID="xxx"
TG_ID="xxx"

# Do not change the following lines if you aren't going to modify the code
# Just rename this file into ".env" instead of ".env.example"

# A single Postgres instance hosts one database per service.
DATABASE_MAIL_PROCESSOR_URL="postgresql+psycopg://admin:password@postgres:5432/mail_processor"
DATABASE_MAIL_MAPPER_URL="postgresql+psycopg://admin:password@postgres:5432/mail_mapper"

GSA_DB_HOST=postgres
GSA_DB_PORT=5432
GSA_DB_USER=admin
GSA_DB_PASS=password
GSA_DB_NAME=gsa
GSA_DB_SSLMODE=disable

MAIL_MAPPER_TIMEOUT=30.0

CLASSIFY_BY_CENTROID_THRESHOLD=0.55
CLASSIFY_BY_CENTROID_THRESHOLDS="applied:0.6, meeting_inv:0.55, meeting_action:0.55, offer:0.55, denied:0.6, pending:0.55"
CLASSIFY_BY_CENTROID_MARGIN=0.01
CLASSIFY_BY_CENTROID_COMMIT_BATCH_SIZE=10
CLASSIFY_BY_CENTROID_THRESHOLD_MULTIPLIER=0.78

HUNGARIAN_MIN_MATCH_SCORE=0.5
